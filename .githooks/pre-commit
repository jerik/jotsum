#!/bin/sh
# index.html is generated by generate-single-html.sh, and the GitHub Action
# rebuilds and commits it on every push to master. If we commit it from here as
# well, both sides write the same lines - the version stamp carries a timestamp
# and the current commit hash, so no two builds ever match - and the next pull
# ends in a conflict. The Action is the only builder; local builds are for
# testing and stay out of the history.
if git diff --cached --name-only | grep -qx 'index.html'; then
    git restore --staged index.html 2>/dev/null || git reset -q HEAD index.html
    echo "note: index.html left out of this commit - it is generated, the GitHub Action builds it."
    echo "      run ./generate-single-html.sh to refresh your local copy for testing."
fi
